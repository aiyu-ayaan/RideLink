    <string name="update_last_checked">கடைசியாகச் சரிபார்த்தது %1$s</string>
    <string name="update_not_checked">இதுவரை சரிபார்க்கப்படவில்லை</string>
    <string name="update_check">புதுப்பிப்புகளைச் சரிபார்</string>
    <string name="update_debug_build">இது ஒரு பிழைத்திருத்த உருவாக்கம். புதுப்பிப்புகள் GitHub-இலிருந்து நிறுவப்பட்ட வெளியீட்டு உருவாக்கங்களுக்கானவை.</string>
    <string name="update_auto">தொடங்கும்போது சரிபார்</string>
    <string name="update_auto_desc">RideLink திறக்கும்போது புதிய வெளியீட்டைத் தேடவும், மணிக்கு அதிகபட்சம் ஒருமுறை. பொது வெளியீட்டுப் பட்டியல் மட்டுமே பெறப்படும்.</string>
    <string name="update_channel">வெளியீட்டுத் தடம்</string>
    <string name="update_channel_stable">நிலையானது</string>
    <string name="update_channel_beta">பீட்டா</string>
    <string name="update_channel_alpha">ஆல்ஃபா</string>
    <string name="update_channel_stable_desc">முழுமையான வெளியீடுகள் மட்டும்.</string>
    <string name="update_channel_beta_desc">வெளியீட்டு வேட்பாளர்கள் மற்றும் நிலையான வெளியீடுகள்.</string>
    <string name="update_channel_alpha_desc">வெளியிடப்பட்டவுடன் ஒவ்வொரு உருவாக்கமும். சில குறைகள் இருக்கலாம்.</string>
    <string name="update_all_releases">GitHub-இல் உள்ள அனைத்து வெளியீடுகளும்</string>
    <string name="update_err_github">GitHub %1$s எனப் பதிலளித்தது. பின்னர் மீண்டும் முயற்சிக்கவும்.</string>
    <string name="update_err_check">GitHub-ஐ அணுக முடியவில்லை. உங்கள் இணைப்பைச் சரிபார்க்கவும்.</string>
    <string name="update_err_download">பதிவிறக்கம் தோல்வியடைந்தது. மீண்டும் முயற்சிக்கவும்.</string>
    <string name="update_err_checksum">பதிவிறக்கம் சேதமடைந்துள்ளது (செக்ஸம் பொருந்தவில்லை). மீண்டும் முயற்சிக்கவும்.</string>
    <string name="update_err_start">நிறுவியைத் தொடங்க முடியவில்லை.</string>
    <string name="update_err_signature">இந்த APK நிறுவப்பட்ட செயலியை விட வேறு சாவியால் கையொப்பமிடப்பட்டுள்ளது. முதலில் RideLink-ஐ நீக்கிவிட்டு, GitHub-இலிருந்து நிறுவவும்.</string>
    <string name="update_err_install">நிறுவல் தோல்வியடைந்தது.</string>

